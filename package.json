{
  "name": "@vinciwu557/pi-subagent",
  "version": "0.1.3",
  "description": "Observable, persistent Pi subagents for independent reviews, investigations, and delegated implementation",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VinciWu557/pi-subagent.git"
  },
  "engines": {
    "node": ">=22.19"
  },
  "type": "module",
  "files": [
    "index.ts",
    "shared.ts",
    "subagent.ts",
    "subagent.js",
    "skills"
  ],
  "scripts": {
    "build": "bun build subagent.ts --target node --outfile subagent.js",
    "prepack": "npm run build",
    "test:e2e": "bash tests/picker-exit.sh"
  },
  "bin": {
    "subagent": "subagent.js"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}
